# Public site never links the reviewer desk. Set an unguessable path segment:
PARAMPARA_ADMIN_PATH=desk-k9m2x7q

# Plaintext secret for local demo (compared via scrypt hash, never stored in cookies).
# Override in production. Prefer PARAMPARA_ADMIN_SECRET_HASH when deploying.
PARAMPARA_ADMIN_SECRET=parampara-demo

# Optional: scrypt hex hash of the admin secret (64 hex chars). Generate with:
#   node scripts/hash-admin-secret.mjs "your-secret"
# PARAMPARA_ADMIN_SECRET_HASH=
# PARAMPARA_ADMIN_SALT=change-me-to-a-long-random-salt

# Signs httpOnly staff session cookies (use a long random string in production).
PARAMPARA_SESSION_SECRET=change-me-to-a-long-random-session-secret
